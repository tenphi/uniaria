{
  "name": "uniaria-monorepo",
  "private": true,
  "description": "UniAria — framework-agnostic headless UI behavior with React and custom-element adapters",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:screen-readers": "vitest run --project screen-readers",
    "test:setup": "playwright install chromium firefox webkit",
    "test:watch": "vitest",
    "bench": "pnpm --filter @uniaria/react bench",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:conformance": "node scripts/check-conformance-separation.mjs",
    "references": "node scripts/fetch-references.mjs",
    "hygiene": "pnpm lint && pnpm format:check && pnpm typecheck",
    "hygiene:fix": "pnpm lint:fix && pnpm format && pnpm typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "size": "pnpm build && size-limit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenphi/uniaria.git"
  },
  "author": "Andrey Yamanov",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.1",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@tenphi/eslint-plugin-tasty": "^1.15.0",
    "@types/node": "^22.20.4",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.9",
    "size-limit": "^14.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.5",
    "web-features": "^3.40.0"
  }
}
