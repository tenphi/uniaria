{
  "name": "@tenphi/sous-testing",
  "version": "0.0.0",
  "description": "Testing tools for Sous: test instances without a framework, the conformance suite runner and screen-reader helpers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "sous-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenphi/sous.git",
    "directory": "packages/sous-testing"
  },
  "keywords": [
    "headless",
    "ui",
    "testing",
    "accessibility",
    "screen-reader"
  ],
  "author": "Andrey Yamanov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tenphi/sous/issues"
  },
  "homepage": "https://github.com/tenphi/sous#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tenphi/sous": "workspace:*"
  }
}
