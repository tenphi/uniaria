{
  "name": "@uniaria/styles",
  "version": "0.3.0",
  "description": "Default styles for UniAria components: prebuilt CSS, a CSS builder and Tasty style objects",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "uniaria-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "uniaria-source": "./src/components/button.ts",
      "types": "./dist/button.d.ts",
      "default": "./dist/button.js"
    },
    "./toggle-button": {
      "uniaria-source": "./src/components/toggle-button.ts",
      "types": "./dist/toggle-button.d.ts",
      "default": "./dist/toggle-button.js"
    },
    "./checkbox": {
      "uniaria-source": "./src/components/checkbox.ts",
      "types": "./dist/checkbox.d.ts",
      "default": "./dist/checkbox.js"
    },
    "./switch": {
      "uniaria-source": "./src/components/switch.ts",
      "types": "./dist/switch.d.ts",
      "default": "./dist/switch.js"
    },
    "./radio": {
      "uniaria-source": "./src/components/radio.ts",
      "types": "./dist/radio.d.ts",
      "default": "./dist/radio.js"
    },
    "./checkbox-group": {
      "uniaria-source": "./src/components/checkbox-group.ts",
      "types": "./dist/checkbox-group.d.ts",
      "default": "./dist/checkbox-group.js"
    },
    "./radio-group": {
      "uniaria-source": "./src/components/radio-group.ts",
      "types": "./dist/radio-group.d.ts",
      "default": "./dist/radio-group.js"
    },
    "./field": {
      "uniaria-source": "./src/components/field.ts",
      "types": "./dist/field.d.ts",
      "default": "./dist/field.js"
    },
    "./text-field": {
      "uniaria-source": "./src/components/text-field.ts",
      "types": "./dist/text-field.d.ts",
      "default": "./dist/text-field.js"
    },
    "./number-field": {
      "uniaria-source": "./src/components/number-field.ts",
      "types": "./dist/number-field.d.ts",
      "default": "./dist/number-field.js"
    },
    "./listbox": {
      "uniaria-source": "./src/components/listbox.ts",
      "types": "./dist/listbox.d.ts",
      "default": "./dist/listbox.js"
    },
    "./select": {
      "uniaria-source": "./src/components/select.ts",
      "types": "./dist/select.d.ts",
      "default": "./dist/select.js"
    },
    "./autocomplete": {
      "uniaria-source": "./src/components/autocomplete.ts",
      "types": "./dist/autocomplete.d.ts",
      "default": "./dist/autocomplete.js"
    },
    "./combobox": {
      "uniaria-source": "./src/components/combobox.ts",
      "types": "./dist/combobox.d.ts",
      "default": "./dist/combobox.js"
    },
    "./dialog": {
      "uniaria-source": "./src/components/dialog.ts",
      "types": "./dist/dialog.d.ts",
      "default": "./dist/dialog.js"
    },
    "./popover": {
      "uniaria-source": "./src/components/popover.ts",
      "types": "./dist/popover.d.ts",
      "default": "./dist/popover.js"
    },
    "./tooltip": {
      "uniaria-source": "./src/components/tooltip.ts",
      "types": "./dist/tooltip.d.ts",
      "default": "./dist/tooltip.js"
    },
    "./build": {
      "uniaria-source": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./palette": {
      "uniaria-source": "./src/palette/index.ts",
      "types": "./dist/palette.d.ts",
      "default": "./dist/palette.js"
    },
    "./tasty": {
      "uniaria-source": "./src/plugin.ts",
      "types": "./dist/tasty.d.ts",
      "default": "./dist/tasty.js"
    },
    "./tasty.config": {
      "uniaria-source": "./tasty.config.ts",
      "types": "./dist/tasty.config.d.ts",
      "default": "./dist/tasty.config.js"
    },
    "./css": "./dist/css/index.css",
    "./css/layered": "./dist/css/layered.css",
    "./css/*.css": "./dist/css/*.css",
    "./package.json": "./package.json"
  },
  "imports": {
    "#default-palette": {
      "uniaria-source": "./src/palette/default.ts",
      "default": "./dist/default-palette.js"
    }
  },
  "files": [
    "dist",
    "tasty.config.js"
  ],
  "scripts": {
    "build": "tsdown",
    "screenshots": "sh scripts/screenshots.sh",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenphi/uniaria.git",
    "directory": "packages/styles"
  },
  "keywords": [
    "headless",
    "ui",
    "styles",
    "css",
    "tasty",
    "accessibility"
  ],
  "author": "Andrey Yamanov",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/tenphi/uniaria/issues"
  },
  "homepage": "https://github.com/tenphi/uniaria#readme",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@tenphi/glaze": "^2.0.1",
    "@tenphi/tasty": "^3.12.0"
  },
  "peerDependenciesMeta": {
    "@tenphi/glaze": {
      "optional": true
    },
    "@tenphi/tasty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tenphi/glaze": "^2.0.1",
    "@tenphi/tasty": "^3.16.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uniaria/core": "workspace:*",
    "@uniaria/elements": "workspace:*",
    "@uniaria/react": "workspace:*",
    "@uniaria/testing": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
