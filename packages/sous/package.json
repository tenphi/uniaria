{
  "name": "@tenphi/sous",
  "version": "0.0.0",
  "description": "Framework-agnostic headless UI behavior: the runtime, interactions and component definitions behind the Sous adapters",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "sous-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "sous-source": "./src/dom/index.ts",
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./collections": {
      "sous-source": "./src/collections/index.ts",
      "types": "./dist/collections/index.d.ts",
      "default": "./dist/collections/index.js"
    },
    "./button": {
      "sous-source": "./src/components/button/index.ts",
      "types": "./dist/button/index.d.ts",
      "default": "./dist/button/index.js"
    },
    "./toggle-button": {
      "sous-source": "./src/components/toggle-button/index.ts",
      "types": "./dist/toggle-button/index.d.ts",
      "default": "./dist/toggle-button/index.js"
    },
    "./field": {
      "sous-source": "./src/components/field/index.ts",
      "types": "./dist/field/index.d.ts",
      "default": "./dist/field/index.js"
    },
    "./text-field": {
      "sous-source": "./src/components/text-field/index.ts",
      "types": "./dist/text-field/index.d.ts",
      "default": "./dist/text-field/index.js"
    },
    "./checkbox": {
      "sous-source": "./src/components/checkbox/index.ts",
      "types": "./dist/checkbox/index.d.ts",
      "default": "./dist/checkbox/index.js"
    },
    "./checkbox-group": {
      "sous-source": "./src/components/checkbox-group/index.ts",
      "types": "./dist/checkbox-group/index.d.ts",
      "default": "./dist/checkbox-group/index.js"
    },
    "./dialog": {
      "sous-source": "./src/components/dialog/index.ts",
      "types": "./dist/dialog/index.d.ts",
      "default": "./dist/dialog/index.js"
    },
    "./radio": {
      "sous-source": "./src/components/radio/index.ts",
      "types": "./dist/radio/index.d.ts",
      "default": "./dist/radio/index.js"
    },
    "./radio-group": {
      "sous-source": "./src/components/radio-group/index.ts",
      "types": "./dist/radio-group/index.d.ts",
      "default": "./dist/radio-group/index.js"
    },
    "./switch": {
      "sous-source": "./src/components/switch/index.ts",
      "types": "./dist/switch/index.d.ts",
      "default": "./dist/switch/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenphi/sous.git",
    "directory": "packages/sous"
  },
  "keywords": [
    "headless",
    "ui",
    "accessibility",
    "a11y",
    "aria",
    "framework-agnostic",
    "components"
  ],
  "author": "Andrey Yamanov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tenphi/sous/issues"
  },
  "homepage": "https://github.com/tenphi/sous#readme",
  "engines": {
    "node": ">=22"
  }
}
