{
  "name": "@uniaria/testing",
  "version": "0.0.0",
  "description": "Testing tools for UniAria: test instances without a framework, the conformance suite runner and screen-reader helpers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "uniaria-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "uniaria-source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./commands": {
      "uniaria-source": "./src/commands.ts",
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenphi/uniaria.git",
    "directory": "packages/testing"
  },
  "keywords": [
    "headless",
    "ui",
    "testing",
    "accessibility",
    "screen-reader"
  ],
  "author": "Andrey Yamanov",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/tenphi/uniaria/issues"
  },
  "homepage": "https://github.com/tenphi/uniaria#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@uniaria/core": "workspace:*"
  },
  "peerDependencies": {
    "@guidepup/guidepup": "^0.35.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@guidepup/guidepup": {
      "optional": true
    }
  },
  "devDependencies": {
    "@guidepup/guidepup": "^0.35.0"
  }
}
